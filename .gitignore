# app ships a snapshot; the daily updater refreshes it when Yahoo is reachable).
!/data/tqqq_data.csv
!/data/vix_data.csv
!/data/sp500_data.csv

# Generated outputs (not checked in)
/results/
/logs/

# Plots: keep only the assets referenced by report.html
/plots/*
!/plots/equity_curve.png
!/plots/trade_*.png

# macOS
.DS_Store
